{
  "name": "goalforgex-flightlink",
  "productName": "GoalForgeX FlightLink",
  "version": "1.1.0",
  "description": "GoalForgeX FlightLink — sends Microsoft Flight Simulator 2024 telemetry to your GoalForgeX Scene Studio overlays.",
  "author": "GoalForgeX",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "check": "node scripts/check.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "node-simconnect": "4.2.1"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.20"
  },
  "build": {
    "appId": "com.goalforgex.flightlink",
    "productName": "GoalForgeX FlightLink",
    "copyright": "GoalForgeX",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "goalforgex-flightlink-${version}-windows-x64-installer.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GoalForgeX FlightLink",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
